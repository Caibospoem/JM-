<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#1B1B22</color>
    <color name="jm_error_text">#333333</color>
    <color name="jm_green">#2F9E44</color>
    <color name="jm_orange">#EE8323</color>
    <color name="jm_page_bg">#4A4A4A</color>
    <string name="app_name">JMComic2</string>
    <string name="jm_choose_line">請選擇線路</string>
    <string name="jm_line_1">線路1</string>
    <string name="jm_line_2">線路2</string>
    <string name="jm_line_3">線路3</string>
    <string name="jm_line_4">線路4</string>
    <string name="jm_line_loading">線路讀取中...</string>
    <string name="jm_line_ok">順暢</string>
    <string name="jm_line_tip">* 如果不能連接或不能載圖，請嘗試切換線路</string>
    <string name="jm_web_error">Error loading page\n菜波制作\nDomain: undefined\nError Code: -6\nDescription:\nnet::ERR_CONNECTION_CLOSED</string>
    <style name="JmLineButton">
        <item name="android:layout_width">200dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="JmLineDot">
        <item name="android:layout_width">12dp</item>
        <item name="android:layout_height">12dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_green_dot</item>
    </style>
    <style name="JmLineOk">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">@string/jm_line_ok</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="JmLineText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/jm_orange</item>
        <item name="android:textSize">21sp</item>
    </style>
    <style name="JmLineText.White">
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="Theme.JmPrank" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">#1B1B22</item>
        <item name="android:navigationBarColor">#1B1B22</item>
        <item name="android:windowBackground">#1B1B22</item>
    </style>
    <style name="Theme.JmPrank.Line">
        <item name="android:statusBarColor">@color/jm_page_bg</item>
        <item name="android:navigationBarColor">@color/jm_page_bg</item>
        <item name="android:windowBackground">@color/jm_page_bg</item>
    </style>
</resources>