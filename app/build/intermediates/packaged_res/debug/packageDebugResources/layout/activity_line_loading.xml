<?xml version="1.0" encoding="utf-8"?>
<!-- 线路读取中页：jm 选择线路前的过渡加载页（1:1 还原截图） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jm_page_bg"
    android:orientation="vertical">

    <!-- 顶部白块：与线路选择页保持一致（白色公告栏不变） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="64dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:paddingStart="14dp"
            android:paddingTop="30dp"
            android:paddingEnd="14dp"
            android:paddingBottom="30dp"
            android:text="@string/jm_web_error"
            android:textColor="@color/jm_error_text"
            android:textSize="15sp" />

        <!-- 截图里白框右缘的橙色小竖条（jm 的 WebView 滚动条痕迹）；
             觉得多余就删掉这个 View -->
        <View
            android:layout_width="7dp"
            android:layout_height="44dp"
            android:layout_gravity="end|top"
            android:layout_marginEnd="5dp"
            android:background="@color/jm_orange" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/jm_choose_line"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/jm_line_tip"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <!-- 白色转圈 -->
    <ProgressBar
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="48dp"
        android:indeterminateTint="#FFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/jm_line_loading"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

</LinearLayout>
